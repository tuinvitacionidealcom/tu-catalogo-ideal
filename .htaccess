<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Evitar bucle infinito si ya estamos en seo.php
  RewriteRule ^seo\.php$ - [L]
  
  # Si el archivo o directorio existe realmente (imagenes, css, js, etc.), servirlo directo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Excluir la carpeta del backend de estas reglas para que las APIs sigan funcionando
  RewriteCond %{REQUEST_URI} !^/backend/
  
  # Todo el resto del tráfico (las rutas de React) mandarlo a seo.php
  RewriteRule . /seo.php [L]
</IfModule>
