<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

ErrorDocument 404 /seo.php

# Evitar bucle
RewriteRule ^seo\.php$ - [L]

# Excluir backend
RewriteCond %{REQUEST_URI} !^/backend/

# Si NO es archivo ni directorio, enviar a seo.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ seo.php [L,QSA]
</IfModule>
