Options -MultiViews
RewriteEngine On
RewriteBase /

# =============================================
# REACT SPA - Fallback Routing (Hostinger)
# =============================================

# Primero: si el archivo o directorio existe físicamente, servirlo directo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Segundo: no redirigir el backend PHP
RewriteCond %{REQUEST_URI} ^/backend/ [NC]
RewriteRule ^ - [L]

# Tercero: todo lo demás → index.html (React Router maneja las rutas)
RewriteRule ^ /index.html [QSA,L]

# =============================================
# CACHE - Assets estáticos (JS/CSS con hash)
# =============================================
<IfModule mod_expires.c>
    ExpiresActive On
    # Assets con hash en el nombre → cache largo (1 año)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    # Imágenes → cache medio (1 mes)
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    # HTML → sin cache (para updates inmediatos)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# =============================================
# SEGURIDAD
# =============================================
# Ocultar archivos sensibles
<FilesMatch "\.(sql|env|log|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
